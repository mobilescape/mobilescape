---
const base = '/mobilescape';
const { title = 'Mobilescape Lab', description = 'Urban mobility research laboratory' } = Astro.props;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="header">
      <a class="brand" href={`${base}/`}>MOBILES<em>CAPE</em></a>
      <nav aria-label="Primary navigation">
        <a href={`${base}/`}>Home</a>
        <a href={`${base}/people/`}>People</a>
        <a href={`${base}/research/`}>Research</a>
        <a href={`${base}/publications/`}>Publications</a>
        <a href={`${base}/news/`}>News</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <p>Mobilescape · Urban Mobility Research Laboratory</p>
      <a href="https://choi-junyong.dankook.ac.kr/">CHOI JUNYONG Homepage</a>
    </footer>
  </body>
</html>

<style is:global>
  :root { --ink: #16202d; --muted: #697487; --line: #e4e8ef; --accent: #d8ff57; --paper: #f7f8fa; }
  * { box-sizing: border-box; }
  body { margin: 0; color: var(--ink); background: #fff; font-family: Inter, "Pretendard", "Noto Sans KR", sans-serif; }
  a { color: inherit; text-decoration: none; }
  .header { max-width: 1120px; height: 84px; margin: auto; padding: 0 28px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); }
  .brand { font-size: 18px; font-weight: 900; letter-spacing: -.02em; }
  .brand em { color: #91a700; font-style: normal; }
  nav { display: flex; gap: 26px; font-size: 14px; }
  nav a:hover { color: #657000; }
  main { max-width: 1120px; min-height: 520px; margin: auto; padding: 72px 28px; }
  h1 { max-width: 820px; margin: 0 0 24px; font-size: clamp(44px, 8vw, 78px); line-height: 1; letter-spacing: -.055em; }
  h2 { font-size: 24px; }
  p { color: var(--muted); line-height: 1.75; }
  .lead { max-width: 700px; font-size: 20px; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 48px; }
  .card { min-height: 190px; padding: 24px; border: 1px solid var(--line); border-radius: 12px; background: var(--paper); }
  .card h2 { margin: 0 0 12px; }
  .button { display: inline-block; margin-top: 24px; padding: 13px 18px; border-radius: 8px; color: var(--ink); background: var(--accent); font-size: 14px; font-weight: 800; }
  footer { max-width: 1120px; margin: auto; padding: 32px 28px 48px; border-top: 1px solid var(--line); }
  footer p { margin: 4px 0 12px; font-size: 13px; }
  footer a { font-size: 13px; border-bottom: 1px solid var(--ink); }
  @media (max-width: 720px) {
    .header { height: auto; padding: 20px; align-items: flex-start; gap: 16px; }
    nav { flex-wrap: wrap; justify-content: flex-end; gap: 10px 16px; }
    main { padding-top: 48px; }
    .grid { grid-template-columns: 1fr; }
  }
</style>
