<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign current_lang = page.lang | default: 'ko' %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.inline %}
                {% if current_lang == 'en' %}
                  {% assign display_content = item.content_en | default: item.content %}
                {% else %}
                  {% assign display_content = item.content_ko | default: item.content %}
                {% endif %}
                {{ display_content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                {% if current_lang == 'en' %}
                  {% assign display_title = item.title_en | default: item.title %}
                {% else %}
                  {% assign display_title = item.title_ko | default: item.title %}
                {% endif %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ display_title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
